# Copy to `.env` and fill in the providers you actually use.
# Axe does not require OpenAI — any one provider (or a local model) is enough.

# Hosted open-weight providers (OpenAI-compatible)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
FIREWORKS_API_KEY=

# Jev decision model (Phase 3)
JEV_API_KEY=

# Local inference
OLLAMA_HOST=http://localhost:11434
# VLLM_API_KEY=
# VLLM_BASE_URL=http://localhost:8000/v1
# LLAMACPP_API_KEY=
# LLAMACPP_BASE_URL=http://localhost:8080/v1

# Optional: override endpoints
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional legacy OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
